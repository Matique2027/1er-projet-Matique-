<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Massif</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<style>
:root{--bg:#fff;--text:#14181f;--muted:#5b6573;--accent:#1f6f50;--card:#f3f5f7;--line:#dde2e8}
@media(prefers-color-scheme:dark){:root{--bg:#0f1318;--text:#f1f3f5;--muted:#9aa5b3;--accent:#4cc38a;--card:#1a2028;--line:#2a323d}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.5}
main{max-width:520px;margin:0 auto;padding:40px 20px}
h1{font-size:2.2rem;margin:0 0 4px}h2{margin:0 0 12px}
.muted{color:var(--muted)}
.card{background:var(--card);border-radius:12px;padding:16px 20px;margin:12px 0}
label{display:block;margin:12px 0 4px;font-weight:600;font-size:.9rem}
input,select{width:100%;padding:10px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--text);font-size:1rem}
.chk{display:flex;gap:14px;flex-wrap:wrap}.chk label{font-weight:400;display:flex;gap:6px;align-items:center;margin:0}.chk input{width:auto}
button{margin-top:16px;width:100%;padding:12px;border:0;border-radius:10px;background:var(--accent);color:#fff;font-size:1rem;font-weight:600;cursor:pointer}
button.link{background:none;color:var(--muted);font-weight:400;text-decoration:underline;margin-top:8px}
.kpi{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;text-align:center}
.kpi b{display:block;font-size:1.3rem}.err{color:#d33;min-height:1.4em}
button.tab{width:auto;margin:4px 6px 0 0;padding:8px 12px;font-weight:500}
button.tab.on{outline:2px solid var(--text)}
.set{display:grid;grid-template-columns:2rem 1fr 1fr 2rem;gap:6px;align-items:center;margin:4px 0}.set input[type=checkbox]{width:auto}
.ex{margin:14px 0 4px;font-weight:600}
[hidden]{display:none!important}
</style>
</head>
<body>
<main>
<h1>Massif</h1>
<p class="muted">Repas &amp; musculation, sur mesure</p>

<section id="v-auth" class="view" hidden>
  <div class="card">
    <label>E-mail</label><input id="email" type="email" autocomplete="email">
    <label>Mot de passe (8 caractères minimum)</label><input id="pwd" type="password" autocomplete="current-password">
    <p class="err" id="authErr"></p>
    <button onclick="auth('in')">Se connecter</button>
    <button class="link" onclick="auth('up')">Créer un compte</button>
  </div>
</section>

<section id="v-onb" class="view" hidden>
  <h2>Ton profil</h2>
  <div class="card">
    <label>Sexe</label><select id="sex"><option value="homme">Homme</option><option value="femme">Femme</option></select>
    <label>Âge</label><input id="age" type="number" min="18" max="100">
    <label>Taille (cm)</label><input id="height" type="number" min="120" max="230">
    <label>Poids (kg)</label><input id="weight" type="number" step="0.1" min="35" max="200">
    <label>Activité au quotidien</label>
    <select id="activity"><option value="sedentaire">Sédentaire</option><option value="modere" selected>Modérée</option><option value="actif">Active</option></select>
    <label>Jours d’entraînement par semaine</label>
    <select id="days"><option>3</option><option selected>4</option><option>5</option></select>
    <label>Où t’entraînes-tu ?</label>
    <select id="loc"><option value="salle">En salle</option><option value="maison_halteres">À la maison, avec haltères</option><option value="maison_sans">À la maison, sans matériel</option></select>
    <label>Budget courses par semaine (€)</label><input id="budget" type="number" min="10" max="200" value="50">
    <label>Je ne mange pas…</label>
    <div class="chk" id="excl">
      <label><input type="checkbox" value="viande">viande</label>
      <label><input type="checkbox" value="poisson">poisson</label>
      <label><input type="checkbox" value="lactose">lactose</label>
      <label><input type="checkbox" value="gluten">gluten</label>
    </div>
    <p class="err" id="onbErr"></p>
    <button onclick="saveProfile()">Enregistrer</button>
  </div>
</section>

<section id="v-pay" class="view" hidden>
  <h2>Active ton accès</h2>
  <div class="card">
    <p>Profite de <b>7 jours d’essai</b>, puis ton abonnement démarre. Tu peux l’annuler à tout moment.</p>
    <p class="muted" id="payMsg"></p>
    <button onclick="checkout()">Commencer l’essai</button>
  </div>
</section>

<section id="v-dash" class="view" hidden>
  <h2>Tes objectifs du jour</h2>
  <div class="card kpi" id="kpi"></div>
  <p class="muted">Objectif prise de masse : maintenance + 300 kcal.</p>
  <div class="card">
    <h2>Suivi du poids</h2>
    <label>Poids de cette semaine (kg)</label><input id="wlog" type="number" step="0.1">
    <button onclick="logWeight()">Enregistrer</button>
    <div id="wlist" class="muted"></div>
  </div>
  <div class="card"><h2>Séances</h2><div id="tabs"></div>
    <p class="muted">Choisis une charge qui te laisse 2 répétitions « en réserve ». Quand tu atteins le maximum de répétitions sur toutes les séries, ajoute 2,5 kg à la séance suivante.</p><div id="sess"></div></div>
  <div class="card muted">Plan de repas : bientôt disponible.</div>
</section>

<button class="link" id="out" onclick="sb.auth.signOut()" hidden>Se déconnecter</button>
</main>

<script>
let sb, session, profile, sub, tries = 0;
const $ = (id) => document.getElementById(id);
const show = (id) => {
  document.querySelectorAll('.view').forEach((v) => (v.hidden = v.id !== 'v-' + id));
  $('out').hidden = id === 'auth';
};

(async () => {
  const cfg = await (await fetch('/api/config')).json();
  sb = supabase.createClient(cfg.url, cfg.anon);
  sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') { session = s; render(); } });
  session = (await sb.auth.getSession()).data.session;
  render();
})();

async function auth(mode) {
  $('authErr').textContent = '';
  const creds = { email: $('email').value.trim(), password: $('pwd').value };
  const { data, error } = mode === 'in' ? await sb.auth.signInWithPassword(creds) : await sb.auth.signUp(creds);
  if (error) return ($('authErr').textContent = error.message);
  if (mode === 'up' && !data.session) $('authErr').textContent = 'Compte créé : clique sur le lien reçu par e-mail, puis connecte-toi.';
}

async function render() {
  if (!session) return show('auth');
  const uid = session.user.id;
  const [p, s] = await Promise.all([
    sb.from('profiles').select('*').eq('id', uid).maybeSingle(),
    sb.from('subscriptions').select('status').eq('user_id', uid).maybeSingle(),
  ]);
  profile = p.data; sub = s.data;
  if (!profile) return show('onb');
  if (!sub || !['trialing', 'active'].includes(sub.status)) {
    show('pay');
    if (new URLSearchParams(location.search).get('paid') && tries++ < 10) {
      $('payMsg').textContent = 'Paiement reçu, activation en cours…';
      setTimeout(render, 3000);
    }
    return;
  }
  dash();
}

async function saveProfile() {
  $('onbErr').textContent = '';
  const row = {
    sex: $('sex').value, age: +$('age').value, height_cm: +$('height').value, weight_kg: +$('weight').value,
    activity: $('activity').value, train_days: +$('days').value, location: $('loc').value,
    weekly_budget_eur: +$('budget').value,
    excluded: [...document.querySelectorAll('#excl input:checked')].map((c) => c.value),
  };
  const { error } = await sb.from('profiles').insert({ id: session.user.id, ...row });
  if (error) return ($('onbErr').textContent = 'Vérifie les champs : ' + error.message);
  render();
}

async function checkout() {
  const r = await fetch('/api/checkout', { method: 'POST', headers: { Authorization: 'Bearer ' + session.access_token } });
  const d = await r.json();
  if (d.url) location.href = d.url; else alert(d.error || 'Erreur');
}

async function dash() {
  const p = profile, f = { sedentaire: 1.4, modere: 1.55, actif: 1.7 }[p.activity];
  const bmr = 10 * p.weight_kg + 6.25 * p.height_cm - 5 * p.age + (p.sex === 'homme' ? 5 : -161);
  const kcal = Math.round(bmr * f + 300 + p.kcal_bonus);
  const prot = Math.round(1.8 * p.weight_kg), fat = Math.round(0.9 * p.weight_kg);
  const carb = Math.round((kcal - prot * 4 - fat * 9) / 4);
  $('kpi').innerHTML = [['kcal', kcal], ['Prot. g', prot], ['Gluc. g', carb], ['Lip. g', fat]]
    .map(([l, v]) => `<div><b>${v}</b><span class="muted">${l}</span></div>`).join('');
  show('dash');
  listWeights();
  loadProgram();
}

function monday() {
  const d = new Date(); d.setDate(d.getDate() - ((d.getDay() + 6) % 7));
  return d.toISOString().slice(0, 10);
}
async function logWeight() {
  const w = +$('wlog').value; if (!w) return;
  await sb.from('weight_logs').upsert({ user_id: session.user.id, week_start: monday(), weight_kg: w });
  $('wlog').value = ''; listWeights();
}
async function listWeights() {
  const { data } = await sb.from('weight_logs').select('week_start,weight_kg').order('week_start', { ascending: false }).limit(6);
  $('wlist').textContent = (data || []).map((r) => `${r.week_start} : ${r.weight_kg} kg`).join('  •  ');
}
let prog = null; const exMap = {};
async function loadProgram() {
  const [p, e] = await Promise.all([
    sb.from('programs').select('*').eq('id', `${profile.location}_${profile.train_days}j`).maybeSingle(),
    sb.from('exercises').select('*'),
  ]);
  prog = p.data; (e.data || []).forEach((x) => (exMap[x.id] = x));
  if (!prog) { $('tabs').innerHTML = ''; return ($('sess').textContent = 'Programme bientôt disponible.'); }
  $('tabs').innerHTML = prog.sessions.map((s, i) => `<button class="tab" id="tab${i}" onclick="openSession(${i})">${s.name}</button>`).join('');
  openSession(0);
}
const today = () => new Date().toISOString().slice(0, 10);
async function openSession(i) {
  prog.sessions.forEach((_, k) => $('tab' + k).classList.toggle('on', k === i));
  const s = prog.sessions[i], ids = s.exercises.map((x) => x.exercise_id);
  const { data } = await sb.from('workout_sets').select('*').eq('day', today()).in('exercise_id', ids);
  const saved = {}; (data || []).forEach((r) => (saved[r.exercise_id + r.set_no] = r));
  $('sess').innerHTML = s.exercises.map((x) => {
    const e = exMap[x.exercise_id] || { name: x.exercise_id, cue: '' };
    let rows = '';
    for (let n = 1; n <= x.sets; n++) {
      const r = saved[x.exercise_id + n] || {};
      rows += `<div class="set" data-ex="${x.exercise_id}" data-n="${n}"><span class="muted">S${n}</span>
        <input type="number" class="r" placeholder="${x.rep_min}-${x.rep_max} reps" value="${r.reps ?? ''}" onchange="saveSet(this.parentNode)">
        <input type="number" class="l" step="0.5" placeholder="kg" value="${r.load_kg ?? ''}" onchange="saveSet(this.parentNode)">
        <input type="checkbox" class="d" ${r.done ? 'checked' : ''} onchange="saveSet(this.parentNode)"></div>`;
    }
    return `<div class="ex">${e.name} · ${x.sets} × ${x.rep_min}-${x.rep_max} reps</div><div class="muted">${e.cue}</div>${rows}`;
  }).join('');
}
async function saveSet(row) {
  await sb.from('workout_sets').upsert({
    user_id: session.user.id, day: today(), exercise_id: row.dataset.ex, set_no: +row.dataset.n,
    reps: row.querySelector('.r').value ? +row.querySelector('.r').value : null,
    load_kg: row.querySelector('.l').value ? +row.querySelector('.l').value : null,
    done: row.querySelector('.d').checked,
  });
}
</script>
</body>
</html>
